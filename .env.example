# CheckAm - example environment. Copy to .env and fill real values.
# cp .env.example .env

# Database Connection (PostgreSQL via docker-compose.yml)
DATABASE_URL="postgresql://checkam_user:CHANGE_ME@localhost:5454/checkam_db?schema=public"

# Better Auth Configuration (use a long random string in production)
BETTER_AUTH_SECRET="CHANGE_ME_min_32_chars"
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (wired: leave empty to disable Google and keep password only)
# Get these from Google Cloud Console → APIs & Services → Credentials (OAuth client, web app).
# Production needs its authorized redirect URI registered: <app-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenRouter & AI SDK Configuration
# Without a real key the offline heuristic extractor runs (rules still decide verdicts).
OPENROUTER_API_KEY="sk-or-v1-CHANGE_ME"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Arcjet Security & Bot Defense (dry-run in development without a real key)
ARCJET_KEY="ajkey_CHANGE_ME"

# Inngest background jobs (WhatsApp pipeline, mail jobs, chat purge)
# Get both from the Inngest dashboard → your app → settings. The serve
# endpoint (/api/inngest) needs the signing key; sending needs the event key.
# Without them, queueMail falls back loudly and background work stays local.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# For local development
INNGEST_DEV=1

# WhatsApp Meta Cloud API Webhook Secrets
WHATSAPP_WEBHOOK_VERIFY_TOKEN="CHANGE_ME_long_random_token"
WHATSAPP_API_TOKEN="CHANGE_ME_meta_system_user_token"
WHATSAPP_PHONE_NUMBER_ID="CHANGE_ME_phone_number_id"
WHATSAPP_APP_SECRET="CHANGE_ME_meta_app_secret"
WHATSAPP_NUMBER=""
# Test phone number for WhatsApp integration tests (a real Cameroon number you control)
TEST_WHATSAPP_PHONE="237XXXXXXXXX"

# WhatsApp platform rules and cost (spec 0015). The API version is NOT here on
# purpose: it is a constant in src/lib/whatsapp/graph.ts, because an override is
# how a version silently expires. Bump it there and deploy.
# Total replies allowed per phone number per month. Meta gives 1,000 free
# service messages per number per month; the default matches that exactly, so the
# default can never be billed. A value above 1000 opts in to paid messages. 0 is
# honoured and silences the bot. A junk value falls back to 1000.
WHATSAPP_MONTHLY_REPLY_CAP="1000"
# The timezone Meta resets the monthly allowance in, and the one our month key
# uses. Falls back to Africa/Douala when unset or unusable.
WHATSAPP_ACCOUNT_TIMEZONE="Africa/Douala"

# Mail via Nodemailer + Inngest (wired: leave empty to disable sending; triggers fail loud)
# Verify-on-signup, password-reset, and welcome mails are queued as Inngest jobs and sent via this SMTP transport.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CheckAm <no-reply@checkam.cm>"
ALERT_WEBHOOK_URL=""

# Tavily web search for the chat agent (wired: leave empty to disable web search and keep local tools)
TAVILY_API_KEY=""
TAVILY_DAILY_BUDGET="100"

# Chat flyer storage (Vercel Blob in prod, local public/uploads in dev)
# From Vercel dashboard → project → Storage → create a Blob store, then
# connect it (or copy the token here). Server-side only, never NEXT_PUBLIC.
BLOB_READ_WRITE_TOKEN=""

# Public Site Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ANTIC_HOTLINE="8202"
NEXT_PUBLIC_SITE_NAME="CheckAm"

# Local dev only: bypass moderator sign-in on /api/admin (never set in production)
CHECKAM_ADMIN_BYPASS="true"
