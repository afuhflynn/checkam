# CheckAm — example environment. Copy to .env and fill real values.
# cp .env.example .env

# Database Connection (PostgreSQL via docker-compose.yml)
DATABASE_URL="postgresql://checkam_user:CHANGE_ME@localhost:5454/checkam_db?schema=public"

# Better Auth Configuration (use a long random string in production)
BETTER_AUTH_SECRET="CHANGE_ME_min_32_chars"
BETTER_AUTH_URL="http://localhost:3000"

# OpenRouter & AI SDK Configuration
# Without a real key the offline heuristic extractor runs (rules still decide verdicts).
OPENROUTER_API_KEY="sk-or-v1-CHANGE_ME"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Arcjet Security & Bot Defense (dry-run in development without a real key)
ARCJET_KEY="ajkey_CHANGE_ME"

# WhatsApp Meta Cloud API Webhook Secrets
WHATSAPP_WEBHOOK_VERIFY_TOKEN="CHANGE_ME_long_random_token"
WHATSAPP_API_TOKEN="CHANGE_ME_meta_system_user_token"
WHATSAPP_PHONE_NUMBER_ID="CHANGE_ME_phone_number_id"
WHATSAPP_APP_SECRET="CHANGE_ME_meta_app_secret"

# Public Site Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ANTIC_HOTLINE="8202"
NEXT_PUBLIC_SITE_NAME="CheckAm"

# Local dev only: bypass moderator sign-in on /api/admin (never set in production)
CHECKAM_ADMIN_BYPASS="true"
